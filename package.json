{
  "name": "ckgmc-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "wrangler types && astro preview",
    "check": "wrangler types && astro check",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ckgmc --local",
    "db:migrate:remote": "wrangler d1 migrations apply ckgmc --remote",
    "admin:create": "node scripts/create-admin.mjs",
    "import:youtube": "node scripts/import-youtube.mjs",
    "fetch:fonts": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.1",
    "bootstrap": "4.6.2",
    "pretendard": "^1.3.9",
    "sass": "^1.89.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
