/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  # 한 번 https 로 들어온 브라우저는 30일 동안 http 로 접속하지 않습니다 (하위 도메인에는 적용하지 않음)
  Strict-Transport-Security: max-age=2592000
  # 플러그인(object/embed) 금지, <base> 로 주소 바꿔치기 금지, 다른 사이트의 iframe 안에 넣기 금지.
  # 스크립트 출처까지 제한하는 정책은 아직 넣지 않았습니다 (본문 HTML·인라인 스크립트 정리가 먼저 필요).
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'self'

/admin/*
  X-Robots-Tag: noindex

# 임시 주소(workers.dev)는 검색엔진에 노출하지 않음 — 정식 주소는 ckgmc.org
https://ckgmc-site.ckgmc-site.workers.dev/*
  X-Robots-Tag: noindex

# 파일 이름에 내용 해시가 들어 있어 내용이 바뀌면 이름도 바뀌는 파일 — 다시 확인하지 않고 1년 동안 캐시합니다
/images/responsive/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
