---
/** 일대일 양육보고서 목록 (부서·기간 필터, CSV 내려받기) */
export const prerender = false;
import MemberLayout from '../../../layouts/MemberLayout.astro';
import Pager from '../../../components/members/Pager.astro';
import Icon from '../../../components/Icon.astro';
import { countCareReports, DEPARTMENTS, listCareReports } from '../../../lib/reports';
import { DATE_RE, formatLocal, paging, todayLocal } from '../../../lib/http';

const sp = Astro.url.searchParams;
const department = (DEPARTMENTS as readonly string[]).includes(sp.get('department') ?? '') ? sp.get('department')! : '';
const from = DATE_RE.test(sp.get('from') ?? '') ? sp.get('from')! : '';
const to = DATE_RE.test(sp.get('to') ?? '') ? sp.get('to')! : '';
const filter = { department, from, to };

if (sp.get('format') === 'csv') {
  const rows = await listCareReports(filter, 5000);
  const esc = (v: unknown) => `"${String(v ?? '').replace(/"/g, '""')}"`;
  const header = ['양육 날짜', '부서', '바나바', '양육 대상', '주차', '교재', '지난주 출석', '반응', '기도 제목', '보고·건의', '보고자', '제출일'];
  const lines = rows.map((r) => [r.care_date, r.department, r.barnabas_name, r.disciple_name, r.week, r.curriculum, r.attended_last_sunday === 1 ? 'Y' : r.attended_last_sunday === 0 ? 'N' : '', r.response, r.prayer, r.notes, r.reporter_name, formatLocal(r.created_at)].map(esc).join(','));
  const csv = '\uFEFF' + [header.map(esc).join(','), ...lines].join('\r\n');
  return new Response(csv, { headers: { 'content-type': 'text/csv; charset=utf-8', 'content-disposition': `attachment; filename="care-reports-${todayLocal()}.csv"`, 'cache-control': 'private, no-store' } });
}

const total = await countCareReports(filter);
const pg = paging(sp.get('page'), total, 30);
const rows = await listCareReports(filter, pg.perPage, pg.offset);
const csvHref = (() => { const u = new URL(Astro.url); u.searchParams.set('format', 'csv'); u.searchParams.delete('page'); return u.pathname + u.search; })();
---
<MemberLayout title="일대일 양육보고서" subtitle="Care Reports" area="manage">
  <form method="get" class="filter-bar">
    <div class="form-group">
      <label for="department">부서</label>
      <select id="department" name="department" class="form-control">
        <option value="">전체 부서</option>
        {DEPARTMENTS.map((d) => <option value={d} selected={d === department}>{d}</option>)}
      </select>
    </div>
    <div class="form-group"><label for="from">양육 날짜 From</label><input id="from" name="from" type="date" class="form-control" value={from} /></div>
    <div class="form-group"><label for="to">To</label><input id="to" name="to" type="date" class="form-control" value={to} /></div>
    <button type="submit" class="btn btn-primary">검색</button>
    <a href="/manage/care-reports" class="btn btn-link">초기화</a>
    <a href={csvHref} class="btn btn-outline-secondary ml-auto" download><Icon name="download" size={16} /> CSV 내려받기</a>
  </form>

  <p class="text-muted small">총 {total}건</p>
  {rows.length === 0 ? <p class="text-muted">조건에 맞는 보고서가 없습니다.</p> : (
    <div class="table-responsive">
      <table class="table table-sm table-report">
        <thead><tr><th>양육 날짜</th><th>부서</th><th>바나바</th><th>양육 대상</th><th class="num">주차</th><th>지난주 출석</th><th class="num">답글</th><th>제출일</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td><a href={`/members/care-reports/${r.id}`}>{r.care_date}</a></td>
              <td>{r.department}</td>
              <td>{r.barnabas_name}</td>
              <td>{r.disciple_name}</td>
              <td class="num">{r.week}</td>
              <td>{r.attended_last_sunday === 1 ? 'Y' : r.attended_last_sunday === 0 ? 'N' : '–'}</td>
              <td class="num">{r.comment_count > 0 ? <span class="badge badge-primary">{r.comment_count}</span> : '–'}</td>
              <td><time datetime={r.created_at}>{formatLocal(r.created_at, false)}</time></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  <Pager paging={pg} />
</MemberLayout>
