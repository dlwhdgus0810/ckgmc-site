---
/** 리더 보고서 목록 (그룹·기간 필터, CSV 내려받기) */
export const prerender = false;
import MemberLayout from '../../../layouts/MemberLayout.astro';
import Pager from '../../../components/members/Pager.astro';
import Icon from '../../../components/Icon.astro';
import { countCellReports, listCellReports, listGroups, parseAbsentees } from '../../../lib/reports';
import { DATE_RE, formatLocal, paging, todayLocal } from '../../../lib/http';

const sp = Astro.url.searchParams;
const groupId = Number(sp.get('group')) || null;
const from = DATE_RE.test(sp.get('from') ?? '') ? sp.get('from')! : '';
const to = DATE_RE.test(sp.get('to') ?? '') ? sp.get('to')! : '';
const filter = { groupId, from, to };
const groups = await listGroups(false);

if (sp.get('format') === 'csv') {
  const rows = await listCellReports(filter, 5000);
  const esc = (v: unknown) => `"${String(v ?? '').replace(/"/g, '""')}"`;
  const header = ['모임 날짜', 'D그룹', '보고자', '출석', '결석', '결석자', '새가족 현황', '분위기', '준비', '좋았던 점/개선할 점', '심방활동', '심방 요청', '제출일'];
  const lines = rows.map((r) => {
    const ab = parseAbsentees(r.absentees);
    return [r.meeting_date, r.group_name, r.reporter_name, r.attendance, ab.length, ab.map((a) => a.reason ? `${a.name}(${a.reason})` : a.name).join('; '), r.newcomers, r.mood_score ?? '', r.prep_score ?? '', r.reflection, r.visits, r.visit_requests, formatLocal(r.created_at)].map(esc).join(',');
  });
  const csv = '\uFEFF' + [header.map(esc).join(','), ...lines].join('\r\n');
  return new Response(csv, { headers: { 'content-type': 'text/csv; charset=utf-8', 'content-disposition': `attachment; filename="cell-reports-${todayLocal()}.csv"`, 'cache-control': 'private, no-store' } });
}

const total = await countCellReports(filter);
const pg = paging(sp.get('page'), total, 30);
const rows = await listCellReports(filter, pg.perPage, pg.offset);
const csvHref = (() => { const u = new URL(Astro.url); u.searchParams.set('format', 'csv'); u.searchParams.delete('page'); return u.pathname + u.search; })();
---
<MemberLayout title="D그룹 리더 보고서" subtitle="Leader Reports" area="manage">
  <form method="get" class="filter-bar">
    <div class="form-group">
      <label for="group">그룹</label>
      <select id="group" name="group" class="form-control">
        <option value="">전체 그룹</option>
        {groups.map((g) => <option value={g.id} selected={g.id === groupId}>{g.name}{!g.is_active && ' (비활성)'}</option>)}
      </select>
    </div>
    <div class="form-group"><label for="from">모임 날짜 From</label><input id="from" name="from" type="date" class="form-control" value={from} /></div>
    <div class="form-group"><label for="to">To</label><input id="to" name="to" type="date" class="form-control" value={to} /></div>
    <button type="submit" class="btn btn-primary">검색</button>
    <a href="/manage/cell-reports" class="btn btn-link">초기화</a>
    <a href={csvHref} class="btn btn-outline-secondary ml-auto" download><Icon name="download" size={16} /> CSV 내려받기</a>
  </form>

  <p class="text-muted small">총 {total}건</p>
  {rows.length === 0 ? <p class="text-muted">조건에 맞는 보고서가 없습니다.</p> : (
    <div class="table-responsive">
      <table class="table table-sm table-report">
        <thead><tr><th>모임 날짜</th><th>D그룹</th><th>보고자</th><th class="num">출석</th><th class="num">결석</th><th class="num">답글</th><th>심방 요청</th><th>제출일</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td><a href={`/members/cell-reports/${r.id}`}>{r.meeting_date}</a></td>
              <td>{r.group_name}</td>
              <td>{r.reporter_name}</td>
              <td class="num">{r.attendance}</td>
              <td class="num">{parseAbsentees(r.absentees).length}</td>
              <td class="num">{r.comment_count > 0 ? <span class="badge badge-primary">{r.comment_count}</span> : '–'}</td>
              <td>{r.visit_requests ? <span class="badge badge-warning">있음</span> : ''}</td>
              <td><time datetime={r.created_at}>{formatLocal(r.created_at, false)}</time></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  <Pager paging={pg} />
</MemberLayout>
