---
/** 메인 화면 — 각 섹션은 src/components/home/ 에 있습니다. 문구·사진·예배 시간은 src/data/site.json 에서 고칩니다 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import InfoStrip from '../components/home/InfoStrip.astro';
import VerseBand from '../components/home/VerseBand.astro';
import EventList from '../components/home/EventList.astro';
import NoticeCards from '../components/home/NoticeCards.astro';
import ThisWeek from '../components/home/ThisWeek.astro';
import SeriesRow from '../components/home/SeriesRow.astro';
import MinistryGrid from '../components/home/MinistryGrid.astro';
import StoryGrid from '../components/home/StoryGrid.astro';
import NewcomerBand from '../components/home/NewcomerBand.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { site } from '../data/site';
import { getBoardPosts } from '../lib/posts';

const [sermon] = await getBoardPosts('sermons');
const [bulletin] = await getBoardPosts('bulletins');
const [resource] = await getBoardPosts('resources');

const allSeries = (await getCollection('series')).sort(
  (a, b) => (b.data.updated ?? b.data.date).getTime() - (a.data.updated ?? a.data.date).getTime()
);
// 진행 중인 시리즈를 앞에, 그 뒤에 최근 시리즈를 채워 4개까지 (첫 번째는 크게 표시)
const ongoing = allSeries.filter((s) => s.data.ongoing);
const series = [...ongoing, ...allSeries.filter((s) => !s.data.ongoing)].slice(0, 4);

const ministries = (await getCollection('pages', (p) => p.id.startsWith('ministries/') && !p.data.hideFromNav))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

// 빌드 시점(캔자스 기준)의 오늘 — 지난 일정 숨김
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Chicago', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());

const stories = (await getCollection('stories')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout description={site.description}>
  <main id="main" tabindex="-1">
    <Hero />
    <InfoStrip />
    <VerseBand verses={site.verses} today={today} />
    <EventList events={site.events} today={today} />
    <NoticeCards notices={site.notices} today={today} />
    <ThisWeek sermon={sermon} bulletin={bulletin} resource={resource} />
    <SeriesRow series={series} />
    <MinistryGrid pages={ministries} />
    {stories.length > 0 && (
      <section class="section section--surface" aria-labelledby="stories-title">
        <div class="container">
          <SectionHeader id="stories-title" eyebrow="Our Story" title="우리 교회 이야기" more={{ href: '/story', label: '모든 이야기' }} />
          <StoryGrid stories={stories} limit={8} />
        </div>
      </section>
    )}
    <NewcomerBand />
  </main>
</BaseLayout>
