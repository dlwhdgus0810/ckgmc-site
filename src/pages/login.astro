---
/**
 * 로그인: 소셜 로그인(설정된 공급자만 버튼 표시) + 이메일/비밀번호.
 * 개발 환경(astro dev)에서는 이메일만 입력해 바로 들어가는 "개발용 로그인"이 추가로 보입니다 (배포본에는 포함되지 않음).
 */
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Flash from '../components/members/Flash.astro';
import Icon from '../components/Icon.astro';
import { enabledProviders } from '../lib/env';
import { PROVIDERS } from '../lib/auth/oauth';
import { createSession } from '../lib/auth/session';
import { hashPassword, needsRehash, verifyPassword } from '../lib/auth/password';
import { applyAdminBootstrap, clearLoginFailures, createUser, findUserByEmail, recordLoginFailure, tooManyFailures, updateUser } from '../lib/auth/users';
import { EMAIL_RE, formStr, safeNext } from '../lib/http';

const next = safeNext(Astro.url.searchParams.get('next'));
if (Astro.locals.user) return Astro.redirect(next, 302);

const providers = enabledProviders();
const isDev = import.meta.env.DEV;
let error: string | null = null;
let emailValue = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const kind = formStr(fd, 'kind', 20);
  const email = formStr(fd, 'email', 200).toLowerCase();
  const userAgent = Astro.request.headers.get('user-agent');
  emailValue = email;

  if (kind === 'password') {
    const password = formStr(fd, 'password', 200);
    if (!EMAIL_RE.test(email) || !password) {
      error = '이메일과 비밀번호를 입력해 주세요.';
    } else if (await tooManyFailures(email)) {
      error = '로그인 실패가 여러 번 있어 15분 동안 잠시 막았습니다. 잠시 후 다시 시도해 주세요.';
    } else {
      const found = await findUserByEmail(email);
      const ok = !!found?.password_hash && (await verifyPassword(password, found.password_hash));
      if (!found || !ok) {
        let ip: string | null = null;
        try { ip = Astro.clientAddress; } catch { /* 개발 환경 등 */ }
        await recordLoginFailure(email, ip);
        error = '이메일 또는 비밀번호가 맞지 않습니다.';
      } else if (found.status === 'disabled') {
        error = '사용이 중지된 계정입니다. 교회 사무실로 문의해 주세요.';
      } else {
        await clearLoginFailures(email);
        const user = await applyAdminBootstrap(found);
        if (needsRehash(found.password_hash!)) await updateUser(user.id, { password_hash: await hashPassword(password) });
        await createSession(Astro.cookies, user.id, userAgent);
        return Astro.redirect(next, 303);
      }
    }
  } else if (kind === 'dev' && isDev) {
    // 개발 환경 전용: 비밀번호 없이 로그인 (없는 이메일이면 활성 회원으로 새로 만듦)
    if (!EMAIL_RE.test(email)) {
      error = '이메일 형식을 확인해 주세요.';
    } else {
      const user = (await findUserByEmail(email)) ?? (await createUser({ email, name: formStr(fd, 'name', 100) || email.split('@')[0], status: 'active' }));
      await createSession(Astro.cookies, (await applyAdminBootstrap(user)).id, userAgent);
      return Astro.redirect(next, 303);
    }
  } else {
    error = '알 수 없는 요청입니다.';
  }
}
const formAction = Astro.url.pathname + Astro.url.search;
---
<BaseLayout title="로그인" description="교인 전용 기능(D그룹 리더 보고서, 일대일 양육보고서)을 이용하려면 로그인해 주세요.">
  <Fragment slot="head"><meta name="robots" content="noindex, nofollow" /></Fragment>
  <PageBanner title="로그인" subtitle="Sign in" path="/login" />
  <div class="container page-body">
    <main id="main" tabindex="-1">
      <div class="login-card">
        <Flash />
        {error && <div class="alert alert-danger" role="alert">{error}</div>}
        <p class="text-muted small mb-4">D그룹 리더 보고서·일대일 양육보고서 등 교인 전용 기능은 로그인 후 이용할 수 있습니다.</p>

        {providers.length > 0 && (
          <>
            {providers.map((p) => (
              <a class="btn btn-provider" href={`/auth/${p}?next=${encodeURIComponent(next)}`} rel="nofollow">
                {p === 'google' ? (
                  <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.5l6.7-6.7C35.6 2.6 30.2 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.8 6.1C12.3 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-2.8-.4-4H24v8.1h12.9c-.3 2.2-1.7 5.4-4.9 7.6l7.5 5.8c4.5-4.2 7-10.3 7-17.5z"/><path fill="#FBBC05" d="M10.4 28.7A14.6 14.6 0 0 1 9.5 24c0-1.6.3-3.2.8-4.7l-7.8-6.1A24 24 0 0 0 0 24c0 3.9.9 7.5 2.6 10.8l7.8-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.5-5.8c-2 1.4-4.8 2.4-8.4 2.4-6.3 0-11.7-4.1-13.6-9.9l-7.8 6.1C6.5 42.6 14.6 48 24 48z"/></svg>
                ) : (
                  <Icon name="facebook" size={18} />
                )}
                {PROVIDERS[p].label} 계정으로 로그인
              </a>
            ))}
            <div class="login-card__divider">또는 이메일로</div>
          </>
        )}

        <form method="post" action={formAction} novalidate>
          <input type="hidden" name="kind" value="password" />
          <div class="form-group">
            <label for="login-email">이메일</label>
            <input id="login-email" class="form-control" type="email" name="email" value={emailValue} autocomplete="username" required />
          </div>
          <div class="form-group">
            <label for="login-password">비밀번호</label>
            <input id="login-password" class="form-control" type="password" name="password" autocomplete="current-password" required />
          </div>
          <button type="submit" class="btn btn-primary btn-block">로그인</button>
        </form>
        <p class="small text-muted mt-3 mb-0">
          비밀번호를 잊으셨거나 계정이 없으면 교회 사무실(관리자)에 문의해 주세요.
          {providers.length === 0 && <><br />소셜 로그인은 준비 중입니다.</>}
        </p>

        {isDev && (
          <form method="post" action={formAction} class="dev-login">
            <input type="hidden" name="kind" value="dev" />
            <p class="small font-weight-bold text-danger mb-2">개발용 로그인 (astro dev 에서만 보임)</p>
            <div class="form-row">
              <div class="form-group col-7"><input class="form-control form-control-sm" type="email" name="email" placeholder="이메일" required /></div>
              <div class="form-group col-5"><input class="form-control form-control-sm" type="text" name="name" placeholder="이름 (새 계정일 때)" /></div>
            </div>
            <button type="submit" class="btn btn-outline-danger btn-sm">이 이메일로 바로 로그인</button>
            <p class="small text-muted mt-2 mb-0">.dev.vars 의 ADMIN_EMAILS 에 있는 이메일은 관리자가 됩니다.</p>
          </form>
        )}
      </div>
    </main>
  </div>
</BaseLayout>
