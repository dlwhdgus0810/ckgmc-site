---
/** 마이페이지: 내 정보, 내가 낸 보고서와 답글 수 */
export const prerender = false;
import MemberLayout from '../../layouts/MemberLayout.astro';
import StatusBadge from '../../components/members/StatusBadge.astro';
import Icon from '../../components/Icon.astro';
import { listCareReports, listCellReports } from '../../lib/reports';
import { formatLocal } from '../../lib/http';
import { isAdmin } from '../../lib/auth/session';

const user = Astro.locals.user!;
const active = user.status === 'active';
const [cells, cares] = active ? await Promise.all([listCellReports({ userId: user.id }, 30), listCareReports({ userId: user.id }, 30)]) : [[], []];
---
<MemberLayout title="마이페이지" subtitle="My Page">
  {user.status === 'pending' && (
    <div class="alert alert-warning" role="status">
      <strong>승인 대기 중입니다.</strong> 관리자가 교인으로 확인하면 D그룹 리더 보고서와 일대일 양육보고서를 작성할 수 있습니다.
    </div>
  )}

  <div class="report-detail mb-4">
    <dt>이름</dt><dd>{user.name}</dd>
    <dt>이메일</dt><dd>{user.email}</dd>
    <dt>권한 · 상태</dt><dd><StatusBadge role={user.role} status={user.status} /></dd>
  </div>

  {active && (
    <p class="d-flex flex-wrap" style="gap:.5rem">
      <a class="btn btn-primary" href="/members/cell-report"><Icon name="file-text" size={18} /> D그룹 리더 보고서 작성</a>
      <a class="btn btn-outline-primary" href="/members/care-report"><Icon name="heart" size={18} /> 일대일 양육보고서 작성</a>
      {isAdmin(user) && <a class="btn btn-outline-secondary" href="/manage">관리자 대시보드</a>}
    </p>
  )}

  {active && (
    <>
      <h2 class="h5 mt-5 mb-3">내 D그룹 리더 보고서 <span class="text-muted">({cells.length})</span></h2>
      {cells.length === 0 ? <p class="text-muted">아직 제출한 보고서가 없습니다.</p> : (
        <div class="table-responsive">
          <table class="table table-sm table-report">
            <thead><tr><th>모임 날짜</th><th>D그룹</th><th class="num">출석</th><th class="num">결석</th><th class="num">답글</th><th>제출일</th></tr></thead>
            <tbody>
              {cells.map((r) => (
                <tr>
                  <td><a href={`/members/cell-reports/${r.id}`}>{r.meeting_date}</a></td>
                  <td>{r.group_name}</td>
                  <td class="num">{r.attendance}</td>
                  <td class="num">{JSON.parse(r.absentees || '[]').length}</td>
                  <td class="num">{r.comment_count > 0 ? <span class="badge badge-primary">{r.comment_count}</span> : '–'}</td>
                  <td><time datetime={r.created_at}>{formatLocal(r.created_at)}</time></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      <h2 class="h5 mt-5 mb-3">내 일대일 양육보고서 <span class="text-muted">({cares.length})</span></h2>
      {cares.length === 0 ? <p class="text-muted">아직 제출한 보고서가 없습니다.</p> : (
        <div class="table-responsive">
          <table class="table table-sm table-report">
            <thead><tr><th>양육 날짜</th><th>부서</th><th>양육 대상</th><th class="num">주차</th><th class="num">답글</th><th>제출일</th></tr></thead>
            <tbody>
              {cares.map((r) => (
                <tr>
                  <td><a href={`/members/care-reports/${r.id}`}>{r.care_date}</a></td>
                  <td>{r.department}</td>
                  <td>{r.disciple_name}</td>
                  <td class="num">{r.week}주차</td>
                  <td class="num">{r.comment_count > 0 ? <span class="badge badge-primary">{r.comment_count}</span> : '–'}</td>
                  <td><time datetime={r.created_at}>{formatLocal(r.created_at)}</time></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </>
  )}
</MemberLayout>
