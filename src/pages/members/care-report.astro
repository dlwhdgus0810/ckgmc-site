---
/** 일대일 양육보고서 작성 */
export const prerender = false;
import MemberLayout from '../../layouts/MemberLayout.astro';
import Icon from '../../components/Icon.astro';
import ReportErrors from '../../components/members/ReportErrors.astro';
import FieldError from '../../components/members/FieldError.astro';
import { createCareReport, CURRICULA, DEPARTMENTS, MAX_WEEK } from '../../lib/reports';
import { formInt, formStr, isValidDate, setFlash, todayLocal } from '../../lib/http';

const user = Astro.locals.user!;
const values = { department: '', barnabas_name: user.name, disciple_name: '', care_date: todayLocal(), week: '', curriculum: '', attended_last_sunday: '', response: '', prayer: '', notes: '' };
const errors: Record<string, string> = {};
const fieldAttrs = (id: string) => ({ 'aria-invalid': errors[id] ? 'true' as const : undefined, 'aria-describedby': errors[id] ? `${id}-error` : undefined });
const draftKey = `member:${user.id}:care-report`;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  for (const k of Object.keys(values) as (keyof typeof values)[]) values[k] = formStr(fd, k);
  if (!(DEPARTMENTS as readonly string[]).includes(values.department)) errors.department = '부서를 선택해 주세요.';
  if (!values.barnabas_name) errors.barnabas_name = '바나바 이름을 입력해 주세요.';
  if (!values.disciple_name) errors.disciple_name = '양육 대상자 이름을 입력해 주세요.';
  if (!isValidDate(values.care_date)) errors.care_date = '양육 날짜를 확인해 주세요.';
  const week = formInt(fd, 'week');
  if (week === null || week < 1 || week > MAX_WEEK) errors.week = '교육 주차를 선택해 주세요.';
  if (!(CURRICULA as readonly string[]).includes(values.curriculum)) errors.curriculum = '양육 교재를 선택해 주세요.';
  const attended = values.attended_last_sunday === '1' ? 1 : values.attended_last_sunday === '0' ? 0 : null;
  if (attended === null) errors['attended-yes'] = '지난주 새가족 출석 여부를 선택해 주세요.';

  if (Object.keys(errors).length === 0) {
    const id = await createCareReport({
      user_id: user.id, department: values.department, barnabas_name: values.barnabas_name, disciple_name: values.disciple_name,
      care_date: values.care_date, week: week!, curriculum: values.curriculum, attended_last_sunday: attended,
      response: values.response, prayer: values.prayer, notes: values.notes,
    });
    Astro.cookies.set('ck_report_created', `care:${id}`, { path: '/members', httpOnly: true, sameSite: 'lax', secure: import.meta.env.PROD, maxAge: 60 });
    setFlash(Astro.cookies, 'success', '양육보고서가 제출되었습니다. 수고하셨습니다!');
    return Astro.redirect(`/members/care-reports/${id}`, 303);
  }
}
---
<MemberLayout title="일대일 양육보고서" subtitle="One-to-one Care Report">
  <form method="post" class="form-narrow report-form" novalidate data-report-form data-draft-key={draftKey}>
    <ReportErrors errors={errors} />
      <p class="small text-muted">필수 항목은 반드시 입력해 주세요. 나머지 항목은 선택입니다. 입력 내용은 이 탭에 임시 보관되므로 공용 기기에서는 작성 후 탭을 닫아 주세요.</p>
      <p class="small" role="status" data-draft-status></p>
    <div class="form-row">
      <div class="form-group col-md-4">
        <label for="department">부서 선택 <span class="small text-muted">(필수)</span></label>
        <select id="department" name="department" {...fieldAttrs('department')} class="form-control" required>
          <option value="">부서 선택...</option>
          {DEPARTMENTS.map((d) => <option value={d} selected={values.department === d}>{d}</option>)}
        </select>
          <FieldError id="department" message={errors.department} />
      </div>
      <div class="form-group col-md-4">
        <label for="barnabas_name">바나바 이름 <span class="small text-muted">(필수)</span></label>
        <input id="barnabas_name" name="barnabas_name" {...fieldAttrs('barnabas_name')} class="form-control" value={values.barnabas_name} required />
          <FieldError id="barnabas_name" message={errors.barnabas_name} />
      </div>
      <div class="form-group col-md-4">
        <label for="disciple_name">양육 대상자 이름 <span class="small text-muted">(필수)</span></label>
        <input id="disciple_name" name="disciple_name" {...fieldAttrs('disciple_name')} class="form-control" value={values.disciple_name} required />
          <FieldError id="disciple_name" message={errors.disciple_name} />
      </div>
    </div>
    <div class="form-row">
      <div class="form-group col-md-4">
        <label for="care_date">양육 날짜 <span class="small text-muted">(필수)</span></label>
        <input id="care_date" name="care_date" {...fieldAttrs('care_date')} type="date" class="form-control" value={values.care_date} required />
          <FieldError id="care_date" message={errors.care_date} />
      </div>
      <div class="form-group col-md-3">
        <label for="week">교육 주차 <span class="small text-muted">(필수)</span></label>
        <select id="week" name="week" {...fieldAttrs('week')} class="form-control" required>
          <option value="">선택</option>
          {Array.from({ length: MAX_WEEK }, (_, i) => i + 1).map((w) => <option value={w} selected={values.week === String(w)}>{w}주차</option>)}
        </select>
          <FieldError id="week" message={errors.week} />
      </div>
      <div class="form-group col-md-5">
        <label for="curriculum">양육 교재 <span class="small text-muted">(필수)</span></label>
        <select id="curriculum" name="curriculum" {...fieldAttrs('curriculum')} class="form-control" required>
          <option value="">선택...</option>
          {CURRICULA.map((c) => <option value={c} selected={values.curriculum === c}>{c}</option>)}
        </select>
          <FieldError id="curriculum" message={errors.curriculum} />
      </div>
    </div>

    <fieldset class="form-group">
      <legend class="col-form-label pt-0 font-weight-bold">지난주 새가족 출석 여부 <span class="small text-muted">(필수)</span></legend>
      <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="attended_last_sunday" id="attended-yes" {...fieldAttrs('attended-yes')} value="1" checked={values.attended_last_sunday === '1'} required />
        <label class="form-check-label" for="attended-yes">출석함</label>
      </div>
      <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="attended_last_sunday" id="attended-no" {...fieldAttrs('attended-yes')} value="0" checked={values.attended_last_sunday === '0'} />
        <label class="form-check-label" for="attended-no">불출석</label>
      </div>
      <FieldError id="attended-yes" message={errors['attended-yes']} />
    </fieldset>

    <div class="form-group">
      <label for="response">양육 대상자의 반응은 어땠나요? <span class="small text-muted">(선택)</span></label>
      <textarea id="response" name="response" {...fieldAttrs('response')} class="form-control" rows="4">{values.response}</textarea>
          <FieldError id="response" message={errors.response} />
    </div>
    <div class="form-group">
      <label for="prayer">기도 제목 <span class="small text-muted">(선택)</span></label>
      <textarea id="prayer" name="prayer" {...fieldAttrs('prayer')} class="form-control" rows="3">{values.prayer}</textarea>
          <FieldError id="prayer" message={errors.prayer} />
    </div>
    <div class="form-group">
      <label for="notes">보고사항 및 건의사항 <span class="small text-muted">(선택)</span></label>
      <textarea id="notes" name="notes" {...fieldAttrs('notes')} class="form-control" rows="3">{values.notes}</textarea>
          <FieldError id="notes" message={errors.notes} />
    </div>
    <p class="small text-muted">보고서에 대한 답변은 마이페이지의 보고서 상세에서 확인할 수 있습니다.</p>
    <button type="submit" class="btn btn-primary btn-lg"><Icon name="check-circle" size={20} /> 보고서 제출하기</button>
  </form>
</MemberLayout>

<script>
  import { initReportValidation } from '../../scripts/report-validation';
  import { initFormDrafts } from '../../scripts/form-drafts';
  initReportValidation();
  initFormDrafts();
</script>
