---
/** 비밀번호 설정/변경. 소셜 로그인만 쓰던 계정도 여기서 비밀번호를 만들 수 있습니다. */
export const prerender = false;
import MemberLayout from '../../layouts/MemberLayout.astro';
import PasswordInput from '../../components/members/PasswordInput.astro';
import { site, telHref } from '../../data/site';
import { findUserById, updateUser } from '../../lib/auth/users';
import { hashPassword, passwordProblem, verifyPassword } from '../../lib/auth/password';
import { createSession, destroyUserSessions } from '../../lib/auth/session';
import { formStr, setFlash } from '../../lib/http';

const me = (await findUserById(Astro.locals.user!.id))!;
const hasPassword = !!me.password_hash;
let error: string | null = null;
let errorField = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const current = formStr(fd, 'current', 200);
  const next = formStr(fd, 'password', 200);
  const confirm = formStr(fd, 'confirm', 200);
  if (hasPassword && !(await verifyPassword(current, me.password_hash))) { error = '현재 비밀번호가 맞지 않습니다.'; errorField = 'current'; }
  else if (passwordProblem(next)) { error = passwordProblem(next); errorField = 'password'; }
  else if (next !== confirm) { error = '새 비밀번호 확인이 일치하지 않습니다.'; errorField = 'confirm'; }
  else {
    await updateUser(me.id, { password_hash: await hashPassword(next) });
    await destroyUserSessions(me.id); // 다른 기기의 로그인은 모두 해제
    await createSession(Astro.cookies, me.id, Astro.request.headers.get('user-agent'));
    setFlash(Astro.cookies, 'success', hasPassword ? '비밀번호를 변경했습니다. 다른 기기에서는 다시 로그인해야 합니다.' : '비밀번호를 설정했습니다. 이제 이메일과 비밀번호로도 로그인할 수 있습니다.');
    return Astro.redirect('/members', 303);
  }
}
---
<MemberLayout title="비밀번호" subtitle="Password">
  <p class="text-muted">{hasPassword ? '비밀번호를 바꾸면 다른 기기의 로그인은 모두 해제됩니다.' : '아직 비밀번호가 없습니다. 비밀번호를 만들면 소셜 계정 없이도 이메일로 로그인할 수 있습니다.'}</p>
  <form method="post" class="form-narrow" style="max-width:26rem">
    {error && <div class="alert alert-danger" role="alert" tabindex="-1" data-password-error><a href={`#${errorField}`}>{error}</a></div>}
    <input type="hidden" name="email" value={me.email} autocomplete="username" />
    {hasPassword && <PasswordInput id="current" name="current" label="현재 비밀번호" autocomplete="current-password" error={errorField === 'current' ? error ?? undefined : undefined} />}
    <PasswordInput id="password" name="password" label="새 비밀번호" minlength={8} help="8자 이상 입력해 주세요. 다른 사이트와 다른 비밀번호를 사용해 주세요." error={errorField === 'password' ? error ?? undefined : undefined} />
    <PasswordInput id="confirm" name="confirm" label="새 비밀번호 확인" minlength={8} help="새 비밀번호를 한 번 더 입력해 주세요." error={errorField === 'confirm' ? error ?? undefined : undefined} />
    <button type="submit" class="btn btn-primary">{hasPassword ? '비밀번호 변경' : '비밀번호 만들기'}</button>
  </form>
  {hasPassword && <p class="small text-muted mt-4">현재 비밀번호를 잊으셨다면 교회 사무실(<a href={telHref}>{site.phone}</a>)에 재설정을 요청해 주세요.</p>}
</MemberLayout>
<script>
  const error = document.querySelector<HTMLElement>('[data-password-error]');
  error?.focus();
  error?.querySelector('a')?.addEventListener('click', () => {
    const target = error.querySelector('a')?.getAttribute('href')?.slice(1);
    if (target) document.getElementById(target)?.focus();
  });
</script>
