---
/** 우리 교회 이야기(OUR STORY) 상세 페이지: /story/<파일이름> */
import { getCollection, render } from 'astro:content';
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import { formatStoryDate } from '../../lib/posts';

export async function getStaticPaths() {
  const stories = (await getCollection('stories')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return stories.map((story, i) => ({
    params: { id: story.id },
    props: { story, prev: stories[i + 1], next: stories[i - 1] },
  }));
}
const { story, prev, next } = Astro.props;
const { Content } = await render(story);
const images = story.data.images.length ? story.data.images : story.data.image ? [story.data.image] : [];
---
<SubpageLayout path="/story" parentHref="/#our-story" title="우리 교회 이야기" subtitle="Our Story" headerImage="/images/headers/about-story.png" leaf={story.data.title} showTitle={true}>
  <article class="story">
    <p><small class="text-muted"><i class="fa fa-calendar"></i> {formatStoryDate(story.data.date)}</small></p>
    {images[0] && <img src={images[0]} alt="" class="img-fluid w-100 mb-4" />}
    <div class="story-body"><Content /></div>
    {images.length > 1 && (
      <div class="row mt-4">
        {images.slice(1).map((img) => (
          <div class="col-6 col-md-4 mb-3"><a href={img} target="_blank" rel="noopener"><img src={img} alt="" class="img-fluid" loading="lazy" /></a></div>
        ))}
      </div>
    )}
    {story.data.permalink && (
      <p class="mt-3"><a href={story.data.permalink} target="_blank" rel="noopener" class="btn btn-sm btn-primary"><i class="fa fa-facebook-official"></i> 페이스북에서 보기</a></p>
    )}
  </article>
  <hr />
  <div class="d-flex justify-content-between">
    <div>{next && <a href={`/story/${next.id}`}>&laquo; {next.data.title}</a>}</div>
    <div class="text-right">{prev && <a href={`/story/${prev.id}`}>{prev.data.title} &raquo;</a>}</div>
  </div>
  <div class="text-center mt-4"><a href="/#our-story" class="btn btn-light">목록으로</a></div>
</SubpageLayout>
