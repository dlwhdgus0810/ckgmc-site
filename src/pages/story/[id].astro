---
/** 우리 교회 이야기(OUR STORY) 상세 페이지: /story/<파일이름> */
import { getCollection, render } from 'astro:content';
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import { formatKoreanDate } from '../../lib/posts';
import Icon from '../../components/Icon.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';

export async function getStaticPaths() {
  const stories = (await getCollection('stories')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return stories.map((story, i) => ({
    params: { id: story.id },
    props: { story, prev: stories[i + 1], next: stories[i - 1] },
  }));
}
const { story, prev, next } = Astro.props;
const { Content } = await render(story);
const images = story.data.images.length ? story.data.images : story.data.image ? [story.data.image] : [];
// 대표 사진의 실제 크기 (빌드 시 계산, 없으면 속성 생략)
const lead = images[0] ? __IMAGE_SIZES__[images[0]] : undefined;
---
<SubpageLayout path="/story" parentHref="/story" title="우리 교회 이야기" subtitle="Our Story" headerImage="/images/headers/about.jpg" leaf={story.data.title} bannerHeading="p">
  <article class="story" data-story-gallery>
    <h1 class="post__title">{story.data.title}</h1>
    <p><small class="text-muted"><Icon name="calendar" size={14} /> {formatKoreanDate(story.data.date, true)}</small></p>
    {images[0] && <a href={images[0]} data-gallery-image aria-label={`사진 1 / ${images.length} 크게 보기`} target="_blank" rel="noopener"><ResponsiveImage src={images[0]} alt={story.data.title ?? '교회 이야기 대표 사진'} class="img-fluid w-100 mb-4" sizes="(min-width: 992px) 800px, 100vw" fetchpriority="high" {...(lead ?? {})} /></a>}
    <div class="story-body"><Content /></div>
    {images.length > 1 && (
      <div class="row mt-4">
        {images.slice(1).map((img, i) => (
          <div class="col-6 col-md-4 mb-3">
            <a class="story__thumb" data-gallery-image href={img} target="_blank" rel="noopener" aria-label={`사진 ${i + 2} / ${images.length} 크게 보기 (새 창)`}>
              <ResponsiveImage src={img} alt="" loading="lazy" sizes="(min-width: 768px) 260px, 50vw" width="1000" height="750" />
            </a>
          </div>
        ))}
      </div>
    )}
    {story.data.permalink && (
      <p class="mt-3"><a href={story.data.permalink} target="_blank" rel="noopener" class="btn btn-sm btn-primary"><Icon name="facebook" size={16} /> 페이스북에서 보기</a></p>
    )}
    <dialog id="story-gallery" class="story-gallery" aria-labelledby="gallery-caption" data-gallery-dialog {...{ closedby: 'any' }}>
      <div class="story-gallery__toolbar">
        <button type="button" class="btn btn-light" data-gallery-close aria-label="사진 보기 닫기" {...{ commandfor: 'story-gallery', command: 'close' }}>닫기 ✕</button>
        <a class="btn btn-light" data-gallery-original target="_blank" rel="noopener">원본 보기 (새 창)</a>
      </div>
      <img data-gallery-full alt="" />
      <div class="story-gallery__navigation">
        <button type="button" class="btn btn-light" data-gallery-prev aria-label="이전 사진">← 이전</button>
        <p id="gallery-caption" aria-live="polite"></p>
        <button type="button" class="btn btn-light" data-gallery-next aria-label="다음 사진">다음 →</button>
      </div>
    </dialog>
  </article>
  <hr />
  <div class="d-flex justify-content-between">
    <div>{next && <a href={`/story/${next.id}`}>&laquo; {next.data.title}</a>}</div>
    <div class="text-right">{prev && <a href={`/story/${prev.id}`}>{prev.data.title} &raquo;</a>}</div>
  </div>
  <div class="text-center mt-4"><a href="/story" class="btn btn-light">목록으로</a></div>
</SubpageLayout>

<script>
  import '../../scripts/story-gallery';
</script>
