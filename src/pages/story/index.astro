---
/** 우리 교회 이야기 전체 목록 */
import { getCollection } from 'astro:content';
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import StoryGrid from '../../components/home/StoryGrid.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
const stories = (await getCollection('stories')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<SubpageLayout path="/story" title="우리 교회 이야기" subtitle="Our Story" headerImage="/images/headers/about.jpg" description="캔사스중앙글로벌감리교회의 예배와 모임, 행사 소식">
  <StoryGrid stories={stories} />
  <p class="text-center mt-4">
    <a href={site.social.facebook} target="_blank" rel="noopener" class="text-muted"><Icon name="facebook" size={16} /> 페이스북에서 더 보기</a>
  </p>
</SubpageLayout>
