---
/**
 * 모든 페이지의 뼈대: <head>, 상단 SNS 바, 헤더(로고+메뉴), 푸터
 */
import 'font-awesome/css/font-awesome.min.css';
import '../styles/fonts.css';
import '../styles/global.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** 'front' = 메인 화면(짧은 남색 헤더), 'sub' = 서브페이지(배경 이미지 + 제목) */
  variant?: 'front' | 'sub';
  headerImage?: string;
  pageTitle?: string;
  ogImage?: string;
}
const { title, description = site.description, variant = 'sub', headerImage, pageTitle, ogImage = site.ogImage } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} ${site.nameEn}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#364e91" />
    <link rel="preload" href="/fonts/SUIT-Variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Header variant={variant} headerImage={headerImage} pageTitle={pageTitle} />
    <div id="content-wrapper">
      <slot />
    </div>
    <Footer />
    <script>
      import '../scripts/nav';
    </script>
  </body>
</html>
