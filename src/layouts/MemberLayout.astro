---
/**
 * 교인 공간(/members) · 관리자(/manage) 공용 레이아웃: 배너 → [메뉴 | 본문]. 로그인이 필요한 서버 렌더링 페이지에서만 사용.
 */
import BaseLayout from './BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import MemberNav from '../components/members/MemberNav.astro';
import Flash from '../components/members/Flash.astro';

interface Props {
  title: string;
  /** 영문 부제 (배너 eyebrow) */
  subtitle?: string;
  area?: 'members' | 'manage';
  /** 배너 제목을 <p> 로 (본문이 <h1> 을 가질 때) */
  bannerHeading?: 'h1' | 'p';
}
const { title, subtitle, area = 'members', bannerHeading = 'h1' } = Astro.props;
const root = area === 'manage' ? '/manage' : '/members';
const rootLabel = area === 'manage' ? '관리자' : '교인 공간';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isRoot = path === root;
---
<BaseLayout title={title} description={`${rootLabel} — 로그인이 필요한 페이지입니다.`}>
  <Fragment slot="head"><meta name="robots" content="noindex, nofollow" /></Fragment>
  <PageBanner
    title={title}
    subtitle={subtitle ?? (area === 'manage' ? 'Admin' : 'Members')}
    heading={bannerHeading}
    path={root}
    leaf={isRoot ? undefined : title}
    parentHref={root}
    crumbTitle={rootLabel}
  />
  <div class="container page-body">
    <div class="row">
      <div class="col-lg-3 mb-4 mb-lg-0"><MemberNav /></div>
      <div class="col-lg-9">
        <main id="main" tabindex="-1" class="entry-content member-main">
          <Flash />
          <slot />
        </main>
      </div>
    </div>
  </div>
</BaseLayout>
