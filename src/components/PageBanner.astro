---
/**
 * 서브페이지 상단 배너: 배경 사진(선택) + 현재 위치 + 영문 부제 + 제목
 * heading='p' 이면 제목을 <p> 로 그립니다 (게시글처럼 본문이 <h1> 을 가질 때).
 */
import Breadcrumb from './Breadcrumb.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { langOf } from '../lib/lang';
interface Props {
  title: string;
  subtitle?: string;
  image?: string;
  /** 사진에서 보여줄 세로 위치(%). 0 = 맨 위, 50 = 가운데(기본), 100 = 맨 아래 */
  focus?: number;
  heading?: 'h1' | 'p';
  path: string;
  leaf?: string;
  parentHref?: string;
  /** 현재 위치에 표시할 상위 항목 이름 (기본: title). 예: 교인 공간 > D그룹 리더 보고서 */
  crumbTitle?: string;
}
const { title, subtitle, image, focus, heading = 'h1', path, leaf, parentHref, crumbTitle } = Astro.props;
const Tag = heading;
// 넓은 화면에서 사진 양옆에 까는 흐린 바탕은 어차피 흐리게 보이므로 가장 작은 변환본으로 충분합니다
const smallest = image ? __RESPONSIVE_IMAGES__[image]?.srcset.split(', ')[0]?.split(' ')[0] : undefined;
---
<section class:list={['page-banner', { 'page-banner--image': !!image }]} aria-label="페이지 제목">
  {/* 바탕은 넓은 화면에서만 보입니다. lazy 라서 보이지 않는 화면(휴대폰)에서는 내려받지 않습니다 */}
  {image && <img class="page-banner__backdrop" src={smallest ?? image} alt="" aria-hidden="true" loading="lazy" decoding="async" />}
  {/* 이 사진이 하위 페이지에서 가장 먼저 보이는 큰 그림이라 우선해서 받습니다 */}
  {image && <ResponsiveImage class="page-banner__img" src={image} alt="" sizes="(min-width: 1321px) 1320px, 100vw" fetchpriority="high" loading="eager" decoding="async" style={focus === undefined ? undefined : `object-position: center ${focus}%`} />}
  <div class="page-banner__scrim" aria-hidden="true"></div>
  <div class="container page-banner__content">
    <Breadcrumb path={path} fallbackTitle={crumbTitle ?? title} leaf={leaf} parentHref={parentHref} />
    {subtitle && <p class="page-banner__eyebrow" lang={langOf(subtitle)}>{subtitle}</p>}
    <Tag class="page-banner__title" lang={langOf(title)}>{title}</Tag>
  </div>
</section>
