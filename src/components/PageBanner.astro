---
/**
 * 서브페이지 상단 배너: 배경 사진(선택) + 현재 위치 + 영문 부제 + 제목
 * heading='p' 이면 제목을 <p> 로 그립니다 (게시글처럼 본문이 <h1> 을 가질 때).
 */
import Breadcrumb from './Breadcrumb.astro';
interface Props {
  title: string;
  subtitle?: string;
  image?: string;
  heading?: 'h1' | 'p';
  path: string;
  leaf?: string;
  parentHref?: string;
  /** 현재 위치에 표시할 상위 항목 이름 (기본: title). 예: 교인 공간 > D그룹 리더 보고서 */
  crumbTitle?: string;
}
const { title, subtitle, image, heading = 'h1', path, leaf, parentHref, crumbTitle } = Astro.props;
const Tag = heading;
---
<div class:list={['page-banner', { 'page-banner--image': !!image }]}>
  {image && <img class="page-banner__img" src={image} alt="" loading="eager" decoding="async" />}
  <div class="page-banner__scrim" aria-hidden="true"></div>
  <div class="container page-banner__content">
    <Breadcrumb path={path} fallbackTitle={crumbTitle ?? title} leaf={leaf} parentHref={parentHref} />
    {subtitle && <p class="page-banner__eyebrow">{subtitle}</p>}
    <Tag class="page-banner__title">{title}</Tag>
  </div>
</div>
