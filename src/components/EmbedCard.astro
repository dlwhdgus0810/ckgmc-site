---
/**
 * 외부 서비스 iframe 카드 (헌금, 교인등록 폼 등).
 * 항상 "새 창에서 열기" 버튼을 먼저 보여주고, mobile='button-only' 이면 폰에서는 iframe 을 숨깁니다.
 * allowedHosts 를 주면 그 주소에서만 iframe 을 불러옵니다 — 제공처가 frame-ancestors(CSP)로 허용한 도메인이
 * 정해져 있을 때(예: ChurchTrac 은 https://ckgmc.org 만) 다른 주소에서 회색 오류 화면이 뜨는 것을 막습니다.
 */
import Icon from './Icon.astro';
interface Props {
  title: string;
  src: string;
  openUrl: string;
  openLabel?: string;
  height?: string;
  mobile?: 'button-only' | 'iframe';
  note?: string;
  /** 임베드 제공처가 허용한 호스트 이름 목록. 지정하면 그 주소에서만 iframe 을 불러옵니다 */
  allowedHosts?: string[];
  /** 허용되지 않은 주소에서 note 대신 보여줄 안내 */
  blockedNote?: string;
}
const {
  title, src, openUrl, openLabel = '새 창에서 열기', height = '640px', mobile = 'iframe', note,
  allowedHosts, blockedNote = '이 주소에서는 폼을 바로 표시할 수 없습니다. 버튼을 눌러 새 창에서 진행해 주세요.',
} = Astro.props;
const gated = !!allowedHosts?.length;
---
<section
  class:list={['embed-card', { 'embed-card--mobile-button': mobile === 'button-only' }]}
  aria-label={title}
  data-embed-hosts={gated ? allowedHosts!.join(' ') : undefined}
  data-blocked-note={gated ? blockedNote : undefined}
>
  <div class="embed-card__head">
    <div>
      <strong>{title}</strong>
      {(note || gated) && <small data-embed-note>{note}</small>}
    </div>
    <a class="btn btn-primary" href={openUrl} target="_blank" rel="noopener"><Icon name="external" size={16} /> {openLabel}<span class="sr-only"> (새 창)</span></a>
  </div>
  <iframe class="embed-card__frame" src={gated ? undefined : src} data-src={gated ? src : undefined} title={title} loading="lazy" style={`height:${height}`}></iframe>
</section>
<script>
  // 정적 페이지라 빌드 시점에는 어느 주소로 열릴지 모릅니다. 허용 호스트에서만 iframe 을 불러오고, 아니면 안내 문구만 바꿉니다.
  document.querySelectorAll<HTMLElement>('[data-embed-hosts]').forEach((card) => {
    const frame = card.querySelector<HTMLIFrameElement>('iframe[data-src]');
    if (!frame?.dataset.src) return;
    const hosts = (card.dataset.embedHosts ?? '').split(/\s+/).filter(Boolean);
    if (hosts.includes(location.hostname)) {
      frame.src = frame.dataset.src;
    } else {
      const noteEl = card.querySelector('[data-embed-note]');
      if (noteEl && card.dataset.blockedNote) noteEl.textContent = card.dataset.blockedNote;
    }
  });
</script>
