---
/**
 * 게시글 상세: 제목·메타 → 유튜브 영상 → 본문 → PDF(주보) → 첨부 → 이전/다음 글
 * 유튜브에서 자동 등록된 설교는 제목을 "예배 종류 · 설교자 · 날짜"로 나눠 보여주고, 설명의 상용구(예배 안내·헌금·저작권)는 접어 둡니다.
 */
import { render } from 'astro:content';
import Icon from './Icon.astro';
import { slugOf, formatKoreanDate, displayDate, dateTimeAttr, pdfOf, fileUrl, textExcerpt, titleParts, displayTitle, splitDescription, type Post } from '../lib/posts';

interface Props {
  post: Post;
  base: string;
  /** 더 오래된 글 */
  prev?: Post;
  /** 더 최신 글 */
  next?: Post;
}
const { post, base, prev, next } = Astro.props;
const { Content } = await render(post);
const pdf = pdfOf(post);
const otherFiles = post.data.attachments.filter((a) => a !== pdf);
const t = titleParts(post);
// 옮겨온 주보 글은 본문이 PDF 링크 한 줄뿐이라 미리보기와 중복되므로 생략
const norm = (s: string) => s.replace(/\s+/g, '');
const bodyIsPdfLink = !!pdf && norm(textExcerpt(post.body, 300)) === norm(pdf.name);
const hasBody = (post.body ?? '').trim().length > 0 && !bodyIsPdfLink;
// 영상 설명: 구분선 아래는 접기
const split = post.data.youtube ? splitDescription(post.body) : null;
const metaItems = [t.service, t.preacher ?? post.data.writer].filter(Boolean) as string[];
---
<article class="post">
  <header class="post__header">
    <h1 class="post__title">{t.title}</h1>
    <p class="post__meta">
      {metaItems.map((m) => <span>{m}</span>)}
      <time datetime={dateTimeAttr(post)}>{formatKoreanDate(displayDate(post), true)}</time>
    </p>
  </header>

  {post.data.youtube && (
    <div class="media-frame post__video">
      <iframe
        src={`https://www.youtube.com/embed/${post.data.youtube}?rel=0`}
        title={post.data.title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
  )}

  {hasBody && (split ? (
    <div class="post__body">
      {split.intro && <div class="post__intro" set:html={split.intro} />}
      {split.more && (
        <details class="post__more">
          <summary><Icon name="chevron-down" size={16} /> 영상 설명 더 보기 <small>(예배 안내 · 헌금 · 섬기는 사람들)</small></summary>
          <div class="post__more-body" set:html={split.more} />
        </details>
      )}
    </div>
  ) : (
    <div class="post__body"><Content /></div>
  ))}

  {pdf && (
    <section class="pdf-card" aria-label="PDF 문서">
      <div class="pdf-card__head">
        <Icon name="file-text" size={24} />
        <div>
          <strong>{pdf.name}</strong>
          <small>PDF 문서 · 휴대전화에서는 새 창으로 여세요</small>
        </div>
        <div class="pdf-card__actions">
          <a class="btn btn-primary btn-sm" href={fileUrl(pdf.file)} target="_blank" rel="noopener"><Icon name="external" size={16} /> 새 창에서 열기</a>
          <a class="btn btn-outline-primary btn-sm" href={fileUrl(pdf.file)} download><Icon name="download" size={16} /> 다운로드</a>
        </div>
      </div>
      <iframe class="pdf-card__frame d-none d-md-block" src={`${fileUrl(pdf.file)}#view=FitH`} title={pdf.name} loading="lazy"></iframe>
    </section>
  )}

  {otherFiles.length > 0 && (
    <div class="post__files">
      <h2 class="h6">첨부파일</h2>
      <ul>
        {otherFiles.map((a) => (
          <li><a href={fileUrl(a.file)} target="_blank" rel="noopener"><Icon name="paperclip" size={16} /> {a.name}</a></li>
        ))}
      </ul>
    </div>
  )}
</article>

{(prev || next) && (
  <nav class="post__nav" aria-label="이전/다음 글">
    {next ? (
      <a class="card-tile card-tile--flat post__nav-link" rel="next" href={`${base}/${slugOf(next)}`}>
        <span class="card-tile__eyebrow">다음 글</span>
        <span class="post__nav-title">{displayTitle(next)}</span>
      </a>
    ) : <span></span>}
    {prev && (
      <a class="card-tile card-tile--flat post__nav-link" rel="prev" href={`${base}/${slugOf(prev)}`}>
        <span class="card-tile__eyebrow">이전 글</span>
        <span class="post__nav-title">{displayTitle(prev)}</span>
      </a>
    )}
  </nav>
)}
<div class="text-center mt-4">
  <a href={base} class="btn btn-outline-primary">목록</a>
</div>
