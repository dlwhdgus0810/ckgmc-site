---
/** 게시판 목록 (카드 3열) + 페이지네이션 */
import Pagination from './Pagination.astro';
import { getBoardPosts, slugOf, excerptOf, thumbAttrs, formatKoreanDate, isoDate, isNew, titleParts, displayDate, dateTimeAttr, PARSED_BOARDS } from '../lib/posts';

interface Props {
  board: string;
  /** 게시판 페이지 주소 (예: /media/sermons) */
  base: string;
  page?: number;
  perPage?: number;
}
const { board, base, page = 1, perPage = 15 } = Astro.props;
const all = await getBoardPosts(board);
const totalPages = Math.max(1, Math.ceil(all.length / perPage));
const posts = all.slice((page - 1) * perPage, page * perPage);
// 유튜브 제목(예배 | 제목 | 설교자 | 날짜)은 나눠서 보여주고, 유튜브 설명 요약은 생략
const parsed = PARSED_BOARDS.has(board);
---
<section id="loop-blog" aria-label="글 목록">
  {posts.length === 0 ? (
    <p class="text-muted py-4 text-center">아직 등록된 글이 없습니다.</p>
  ) : (
    <div class="row">
      {posts.map((post) => (
        <div class="col-sm-6 col-lg-4 mb-4">
          <a class="card-tile" href={`${base}/${slugOf(post)}`}>
            <div class="card-tile__media"><img {...thumbAttrs(post)} alt="" loading="lazy" width="640" height="360" /></div>
            <div class="card-tile__body">
              {parsed ? (() => { const t = titleParts(post); return (
                <>
                  {t.service && <span class="card-tile__eyebrow">{t.service}</span>}
                  <h2 class="card-tile__title h6">{t.title}</h2>
                  {t.preacher && <p class="card-tile__text">{t.preacher}</p>}
                  <p class="card-tile__meta">
                    <time datetime={dateTimeAttr(post)}>{formatKoreanDate(displayDate(post), true)}</time>
                    {isNew(post.data.date) && <span class="badge-new">NEW</span>}
                  </p>
                </>
              ); })() : (
                <>
                  <h2 class="card-tile__title h6">{post.data.title}</h2>
                  <p class="card-tile__text">{excerptOf(post)}</p>
                  <p class="card-tile__meta">
                    <time datetime={isoDate(post.data.date)}>{formatKoreanDate(post.data.date)}</time>
                    {isNew(post.data.date) && <span class="badge-new">NEW</span>}
                  </p>
                </>
              )}
            </div>
          </a>
        </div>
      ))}
    </div>
  )}
  <Pagination current={page} total={totalPages} base={base} />
</section>
