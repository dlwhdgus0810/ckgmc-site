---
/**
 * 게시판 목록 (카드 3열) + 페이지네이션
 */
import Pagination from './Pagination.astro';
import { getBoardPosts, slugOf, excerptOf, thumbnailOf, formatDateTime, isNew } from '../lib/posts';

interface Props {
  board: string;
  /** 게시판 페이지 주소 (예: /media/sermons) */
  base: string;
  page?: number;
  perPage?: number;
}
const { board, base, page = 1, perPage = 15 } = Astro.props;
const all = await getBoardPosts(board);
const totalPages = Math.max(1, Math.ceil(all.length / perPage));
const posts = all.slice((page - 1) * perPage, page * perPage);
---
<section id="loop-blog">
  {posts.length === 0 ? (
    <p class="text-muted py-4 text-center">아직 등록된 글이 없습니다.</p>
  ) : (
    <div class="row">
      {posts.map((post) => (
        <div class="col-sm-6 col-md-4 mb-4">
          <div class="card board-card hover-scale">
            <a href={`${base}/${slugOf(post)}`}>
              <img src={thumbnailOf(post)} alt="" class="card-img-top" loading="lazy" />
            </a>
            <div class="card-body">
              <a href={`${base}/${slugOf(post)}`}>
                <h5 class="card-title">{post.data.title}</h5>
                <p class="card-text">{excerptOf(post)}</p>
                <p class="card-text">
                  <small class="text-muted">{formatDateTime(post.data.date)}</small>
                  {isNew(post.data.date) && <span class="badge badge-pill badge-success position-absolute" style="top:10px;left:10px;">NEW</span>}
                </p>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  )}
  <Pagination current={page} total={totalPages} base={base} />
</section>
