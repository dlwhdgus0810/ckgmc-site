---
/** 현재 위치 표시 (배너 안에서 사용). HOME / 섹션 / 페이지 [/ 게시글] */
import { getNav, findSection, findNavItem } from '../lib/nav';
interface Props {
  /** 페이지 URL (예: /about/staff) */
  path: string;
  /** 메뉴에 없는 페이지의 표시 제목 */
  fallbackTitle?: string;
  /** 게시글 제목 등 마지막 항목 */
  leaf?: string;
  /** 메뉴에 없는 페이지에서 상위 항목이 가리킬 주소 (기본: path) */
  parentHref?: string;
}
const { path, fallbackTitle, leaf, parentHref = path } = Astro.props;
const nav = await getNav();
const section = findSection(nav, path);
const found = findNavItem(nav, path);
const pageLabel = found?.item.label ?? fallbackTitle ?? '';
// 섹션 목록 페이지(/ministries 등) 자체에서는 섹션 이름이 곧 현재 위치
const isSectionIndex = !!section && path.replace(/\/$/, '') === '/' + section.key;
---
<nav aria-label="현재 위치" class="crumbs">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">HOME</a></li>
    {section?.items && !isSectionIndex && (
      <li class="breadcrumb-item"><a href={'/' + section.key}>{section.label}</a></li>
    )}
    {isSectionIndex ? (
      <li class="breadcrumb-item active" aria-current="page">{section!.label}</li>
    ) : leaf ? (
      <>
        <li class="breadcrumb-item"><a href={parentHref}>{pageLabel}</a></li>
        <li class="breadcrumb-item active" aria-current="page">{leaf}</li>
      </>
    ) : (
      <li class="breadcrumb-item active" aria-current="page">{pageLabel}</li>
    )}
  </ol>
</nav>
