---
interface Props {
  current: number;
  total: number;
  /** 1페이지 주소 (예: /media/sermons). n페이지는 `${base}/page/n` */
  base: string;
}
const { current, total, base } = Astro.props;
const href = (n: number) => (n <= 1 ? base : `${base}/page/${n}`);
const window = 4;
let start = Math.max(1, current - window);
let end = Math.min(total, current + window);
const pages = Array.from({ length: end - start + 1 }, (_, i) => start + i);
---
{total > 1 && (
  <nav aria-label="페이지 이동" class="d-flex justify-content-center py-3">
    <ul class="pagination pagination-sm mb-0">
      {current === 1 ? (
        <>
          <li class="page-item disabled"><span class="page-link">처음</span></li>
          <li class="page-item disabled"><span class="page-link" aria-hidden="true">&lsaquo;</span></li>
        </>
      ) : (
        <>
          <li class="page-item"><a class="page-link" href={href(1)}>처음</a></li>
          <li class="page-item"><a class="page-link" href={href(current - 1)} aria-label="이전 페이지">&lsaquo;</a></li>
        </>
      )}
      {pages.map((n) =>
        n === current ? (
          <li class="page-item active" aria-current="page"><span class="page-link">{n}</span></li>
        ) : (
          <li class="page-item"><a class="page-link" href={href(n)}>{n}</a></li>
        )
      )}
      {current === total ? (
        <>
          <li class="page-item disabled"><span class="page-link" aria-hidden="true">&rsaquo;</span></li>
          <li class="page-item disabled"><span class="page-link">끝</span></li>
        </>
      ) : (
        <>
          <li class="page-item"><a class="page-link" href={href(current + 1)} aria-label="다음 페이지">&rsaquo;</a></li>
          <li class="page-item"><a class="page-link" href={href(total)}>끝</a></li>
        </>
      )}
    </ul>
  </nav>
)}
