---
/** 푸터: 교회 정보 · 예배 시간 · 바로가기 · SNS/헌금 + 하단 저작권 */
import { site, telHref, mapsDirectionsUrl, liveUrl } from '../data/site';
import { footerMemberLinks, footerNav, footerQuickLinks } from '../data/nav';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="container">
    <div class="row site-footer__grid">
      <div class="col-md-6 col-lg-3">
        <h2 class="site-footer__heading">{site.name}</h2>
        <p class="site-footer__sub">{site.nameEn}</p>
        <address class="site-footer__address">
          <a href={mapsDirectionsUrl} target="_blank" rel="noopener"><Icon name="map-pin" size={16} /> {site.address}</a>
          <a href={telHref}><Icon name="phone" size={16} /> {site.phone}</a>
          <a href={`mailto:${site.email}`}><Icon name="mail" size={16} /> {site.email}</a>
        </address>
      </div>
      <div class="col-md-6 col-lg-3">
        <h2 class="site-footer__heading">예배 안내</h2>
        <dl class="site-footer__times">
          {site.serviceTimes.map((s) => (
            <div>
              <dt>{s.name}</dt>
              <dd>{s.time}{s.place && <span> · {s.place}</span>}{s.note && <small>{s.note}</small>}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="col-md-6 col-lg-3">
        <h2 class="site-footer__heading">바로가기</h2>
        <ul class="site-footer__links">
          {footerQuickLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
        <h2 class="site-footer__heading mt-4">교인 전용</h2>
        <ul class="site-footer__links">
          {footerMemberLinks.map((l) => <li><a href={l.href} rel="nofollow">{l.label}</a></li>)}
        </ul>
      </div>
      <div class="col-md-6 col-lg-3">
        <h2 class="site-footer__heading">함께해요</h2>
        <ul class="site-footer__social">
          <li><a href={site.social.facebook} target="_blank" rel="noopener"><Icon name="facebook" size={18} /> Facebook</a></li>
          <li><a href={site.social.youtube} target="_blank" rel="noopener"><Icon name="youtube" size={18} /> YouTube</a></li>
          <li><a href={site.social.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> Instagram</a></li>
        </ul>
        <div class="site-footer__actions">
          <a class="btn btn-gold" href="/offering"><Icon name="heart" size={18} /> 온라인헌금</a>
          <a class="btn btn-outline-light" href={liveUrl} target="_blank" rel="noopener"><Icon name="youtube" size={18} /> YouTube Live</a>
        </div>
      </div>
    </div>
  </div>
  <div class="site-footer__bottom">
    <div class="container d-flex flex-wrap justify-content-between align-items-center">
      <p class="mb-0">&copy; {year} {site.name} {site.nameEn}. All rights reserved.</p>
      <ul class="site-footer__policy">
        {footerNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
