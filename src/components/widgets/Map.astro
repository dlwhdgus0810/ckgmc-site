---
import { site, mapEmbedUrl, mapsDirectionsUrl } from '../../data/site';
---
<div class="embed-responsive embed-responsive-16by9 mb-3">
  <iframe style="border:0;" src={mapEmbedUrl} allowfullscreen loading="lazy" title="찾아오시는 길 지도"></iframe>
</div>
<p><address class="mb-2">{site.address}</address><a class="btn btn-outline-primary btn-sm" href={mapsDirectionsUrl} target="_blank" rel="noopener">Google 지도로 길찾기</a></p>
