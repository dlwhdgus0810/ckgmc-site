---
import { site, telHref } from '../../data/site';
import Icon from '../Icon.astro';
const thanksUrl = new URL(site.formThanksPath, Astro.site).href;
---
<div class="row">
  <div class="col-md-5 mb-4">
    <ul class="contact-info">
      <li><Icon name="map-pin" size={18} /><div><strong>주소</strong><span>{site.address}</span></div></li>
      <li><Icon name="phone" size={18} /><div><strong>전화</strong><a href={telHref}>{site.phone}</a></div></li>
      <li><Icon name="mail" size={18} /><div><strong>이메일</strong><a href={`mailto:${site.email}`}>{site.email}</a></div></li>
      <li><Icon name="facebook" size={18} /><div><strong>페이스북</strong><a href={site.social.facebook} target="_blank" rel="noopener">facebook.com/ckgmckc</a></div></li>
    </ul>
    {site.newFamilyFormUrl && (
      <p class="mt-3"><a class="btn btn-outline-primary btn-sm" href={site.newFamilyFormUrl} target="_blank" rel="noopener"><Icon name="external" size={16} /> 온라인 새가족 등록 신청서</a></p>
    )}
  </div>
  <div class="col-md-7">
    <h2 class="h5 mb-3">문의 메일폼</h2>
    {site.formEndpoint ? (
      <form action={site.formEndpoint} method="POST" id="request-form" class="contact-form">
        <input type="hidden" name="_subject" value="[홈페이지 문의]" />
        <input type="hidden" name="_next" value={thanksUrl} />
        <input type="hidden" name="_template" value="table" />
        <input type="text" name="_honey" class="d-none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form-group">
          <label for="name">이름 <span class="text-muted">Name</span></label>
          <input id="name" class="form-control" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="form-group">
          <label for="email">이메일 <span class="text-muted">E-mail</span></label>
          <input id="email" class="form-control" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="form-group">
          <label for="request_content">문의 내용 <span class="text-muted">Message</span></label>
          <textarea id="request_content" class="form-control" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">전송하기</button>
        <p class="form-note mt-2 mb-0">전송 후 접수 확인 페이지로 이동합니다.</p>
      </form>
    ) : (
      <p>
        <a class="btn btn-primary" href={`mailto:${site.email}?subject=${encodeURIComponent('[홈페이지 문의]')}`}><Icon name="mail" size={18} /> 이메일로 문의하기</a>
        <br /><span class="form-note">이메일 프로그램이 열립니다.</span>
      </p>
    )}
  </div>
</div>
