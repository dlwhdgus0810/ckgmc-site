---
import { site } from '../../data/site';
const thanksUrl = new URL(site.formThanksPath, Astro.site).href;
---
<div class="row">
  <div class="col-sm">
    <hr />
    <ul class="list-unstyled mb-4">
      <li><span class="mr-2"><b>ADDR</b></span>{site.address}</li>
      <li><span class="mr-2"><b>PHONE</b></span><a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a></li>
      <li><span class="mr-2"><b>FACEBOOK</b></span><a href={site.social.facebook} target="_blank" rel="noopener">{site.social.facebook}</a></li>
      <li><span class="mr-2"><b>EMAIL</b></span><a href={`mailto:${site.email}`}>{site.email}</a></li>
    </ul>
  </div>
  <div class="col-sm">
    <h5>문의 메일폼</h5>
    {site.formEndpoint ? (
      <form action={site.formEndpoint} method="POST" id="request-form">
        <input type="hidden" name="_subject" value="[홈페이지 문의]" />
        <input type="hidden" name="_next" value={thanksUrl} />
        <input type="hidden" name="_template" value="table" />
        <input type="text" name="_honey" class="d-none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form-group">
          <label for="name" class="sr-only">이름 Name</label>
          <input id="name" class="form-control" name="name" type="text" placeholder="Name" required />
        </div>
        <div class="form-group">
          <label for="email" class="sr-only">이메일 E-mail</label>
          <input id="email" class="form-control" name="email" type="email" placeholder="Your E-mail" required />
        </div>
        <div class="form-group">
          <label for="request_content" class="sr-only">문의 내용</label>
          <textarea id="request_content" class="form-control" name="message" rows="4" placeholder="Request" required></textarea>
        </div>
        <div class="form-group">
          <button type="submit" class="btn btn-primary">전송하기</button>
        </div>
      </form>
    ) : (
      <p>
        <a class="btn btn-primary" href={`mailto:${site.email}?subject=${encodeURIComponent('[홈페이지 문의]')}`}><i class="fa fa-envelope"></i> 이메일로 문의하기</a>
        <br /><span class="form-note">이메일 프로그램이 열립니다.</span>
      </p>
    )}
  </div>
</div>
{site.newFamilyFormUrl && (
  <p class="mt-3"><a href={site.newFamilyFormUrl} target="_blank" rel="noopener">온라인 새가족 등록 신청서 링크</a></p>
)}
