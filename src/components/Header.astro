---
/**
 * 사이트 헤더: 로고 + 주 메뉴(드롭다운) + 강조 링크. 모바일에서는 햄버거 버튼으로 드로어를 엽니다.
 * 동작(열기/닫기/Esc)은 src/scripts/nav.ts 에 있습니다.
 */
import { site } from '../data/site';
import { headerCtas } from '../data/nav';
import { getNav } from '../lib/nav';
import Icon from './Icon.astro';

const nav = await getNav();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const currentKey = currentPath.split('/').filter(Boolean)[0];
const [welcomeCta, givingCta] = headerCtas;
---
<header class="site-header on-dark">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label={`${site.name} 홈`}>
      <img src={site.logo} alt="" width="274" height="40" />
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="메뉴 열기">
      <Icon name="menu" size={26} class="nav-toggle__open" />
      <Icon name="close" size={26} class="nav-toggle__close" />
    </button>

    <nav id="site-nav" class="site-nav" aria-label="주 메뉴">
      <ul class="site-nav__list">
        {nav.map((section) =>
          section.items ? (
            <li class:list={['site-nav__item has-menu', { 'is-current': section.key === currentKey }]}>
              <button type="button" class="site-nav__link" id={`navbtn-${section.key}`} aria-expanded="false" aria-controls={`navmenu-${section.key}`}>
                <span>{section.label}</span>
                <small>{section.labelEn}</small>
                <Icon name="chevron-down" size={16} />
              </button>
              <ul id={`navmenu-${section.key}`} class="site-nav__menu" aria-labelledby={`navbtn-${section.key}`}>
                {section.items.map((item) => (
                  <li><a href={item.href} aria-current={item.href === currentPath ? 'page' : undefined}>{item.label}</a></li>
                ))}
              </ul>
            </li>
          ) : (
            <li class:list={['site-nav__item', { 'is-current': section.href === currentPath }]}>
              <a class="site-nav__link" href={section.href} aria-current={section.href === currentPath ? 'page' : undefined}>
                <span>{section.label}</span>
                <small>{section.labelEn}</small>
              </a>
            </li>
          )
        )}
      </ul>

      <div class="site-nav__ctas">
        {welcomeCta && <a class="site-nav__cta" href={welcomeCta.href}>{welcomeCta.label}</a>}
        {givingCta && <a class="btn btn-gold btn-sm" href={givingCta.href} aria-current={givingCta.href === currentPath ? 'page' : undefined}>{givingCta.label}</a>}
        <a class="site-nav__account" href="/login" data-account-link title="로그인" aria-label="로그인">
          <Icon name="user" size={18} />
          <span class="site-nav__account-label">로그인</span>
        </a>
        <ul class="site-nav__social">
          <li><a href={site.social.facebook} target="_blank" rel="noopener" aria-label="페이스북 (새 창)"><Icon name="facebook" size={18} /></a></li>
          <li><a href={site.social.youtube} target="_blank" rel="noopener" aria-label="유튜브 (새 창)"><Icon name="youtube" size={18} /></a></li>
          <li><a href={site.social.instagram} target="_blank" rel="noopener" aria-label="인스타그램 (새 창)"><Icon name="instagram" size={18} /></a></li>
        </ul>
      </div>
    </nav>
  </div>
</header>
<script>
  // 정적 페이지라 서버는 로그인 여부를 모릅니다. 로그인 시 발급되는 ck_auth 쿠키(값 없음)로 링크만 바꿉니다.
  const link = document.querySelector<HTMLAnchorElement>('[data-account-link]');
  if (link && document.cookie.split('; ').some((c) => c.startsWith('ck_auth='))) {
    const label = link.querySelector('.site-nav__account-label');
    if (label) label.textContent = '마이페이지';
    link.href = '/members';
    link.title = '마이페이지';
    link.setAttribute('aria-label', '마이페이지');
    link.classList.add('is-signed-in');
  }
</script>
