---
interface Props {
  id: string;
  name: string;
  label: string;
  autocomplete?: string;
  minlength?: number;
  required?: boolean;
  help?: string;
  copy?: boolean;
  error?: string;
}
const { id, name, label, autocomplete = 'new-password', minlength, required = true, help, copy = false, error } = Astro.props;
---
<div class="form-group password-field" data-password-field>
  <label for={id}>{label} <span class="small text-muted">({required ? '필수' : '선택'})</span></label>
  <div class="password-field__controls">
    <input id={id} name={name} type="password" class="form-control" autocomplete={autocomplete} minlength={minlength} required={required} aria-invalid={error ? 'true' : undefined} aria-describedby={[help ? `${id}-help` : '', error ? `${id}-error` : ''].filter(Boolean).join(' ') || undefined} />
    <button type="button" class="btn btn-outline-secondary" data-password-toggle aria-controls={id} aria-pressed="false" aria-label={`${label} 표시`}>표시</button>
    {copy && <button type="button" class="btn btn-outline-secondary" data-password-copy aria-controls={id} aria-label={`${label} 복사`}>복사</button>}
  </div>
  {help && <small id={`${id}-help`} class="form-text text-muted">{help}</small>}
  {error && <p id={`${id}-error`} class="small text-danger mt-1">{error}</p>}
  {copy && <span class="small" role="status" data-password-status></span>}
</div>
<style>
  .password-field__controls { display: flex; gap: .375rem; align-items: stretch; }
  .password-field__controls input { min-width: 0; flex: 1; }
  .password-field__controls button { flex: none; padding-inline: .75rem; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-password-field]').forEach((field) => {
    const input = field.querySelector<HTMLInputElement>('input');
    const toggle = field.querySelector<HTMLButtonElement>('[data-password-toggle]');
    if (!input || !toggle) return;
    const label = field.querySelector('label')?.textContent?.replace(/\s*\((필수|선택)\)\s*$/, '').trim() || '비밀번호';
    toggle.addEventListener('click', () => {
      const visible = input.type === 'password';
      input.type = visible ? 'text' : 'password';
      toggle.textContent = visible ? '숨기기' : '표시';
      toggle.setAttribute('aria-pressed', String(visible));
      toggle.setAttribute('aria-label', `${label} ${visible ? '숨기기' : '표시'}`);
    });
    field.querySelector('[data-password-copy]')?.addEventListener('click', async () => {
      const status = field.querySelector<HTMLElement>('[data-password-status]');
      if (!status) return;
      if (!input.value) { status.textContent = '먼저 비밀번호를 입력해 주세요.'; return; }
      try { await navigator.clipboard.writeText(input.value); status.textContent = '비밀번호를 복사했습니다.'; }
      catch { status.textContent = '복사할 수 없습니다. 표시 버튼으로 확인한 뒤 직접 복사해 주세요.'; }
    });
  });
</script>
