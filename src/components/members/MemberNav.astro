---
/** 교인 공간 왼쪽 메뉴 (관리자는 관리 메뉴가 더 보임). 표현은 SectionNav 와 같은 스타일을 씁니다. */
import Icon from '../Icon.astro';
import { isAdmin } from '../../lib/auth/session';
const user = Astro.locals.user;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const memberLinks = [
  { href: '/members', label: '마이페이지' },
  { href: '/members/cell-report', label: 'D그룹 리더 보고서' },
  { href: '/members/care-report', label: '일대일 양육보고서' },
  { href: '/members/password', label: '비밀번호' },
];
const manageLinks = [
  { href: '/manage', label: '대시보드' },
  { href: '/manage/content', label: '콘텐츠 관리' },
  { href: '/manage/cell-reports', label: '리더 보고서' },
  { href: '/manage/care-reports', label: '일대일 양육보고서' },
  { href: '/manage/groups', label: 'D그룹 관리' },
  { href: '/manage/stats', label: '그룹 통계' },
  { href: '/manage/users', label: '회원 관리' },
];
const cmsLink = { href: '/admin/', label: '개발자용 CMS (GitHub)' };
const cur = (href: string) => (href === path || (href !== '/manage' && href !== '/members' && path.startsWith(href + '/')) ? 'page' : undefined);
const inManage = path.startsWith('/manage');
const currentMember = memberLinks.find((l) => cur(l.href))?.label ?? '내 보고서';
const currentManage = manageLinks.find((l) => cur(l.href))?.label ?? '관리자';
---
<nav class="section-nav member-nav" aria-label="교인 공간 메뉴">
  {user && (
    <div class="member-nav__user">
      <div class="member-nav__who">
        {user.avatar_url ? <img src={user.avatar_url} alt="" width="32" height="32" /> : <span class="member-nav__initial" aria-hidden="true">{user.name.slice(0, 1)}</span>}
        <div><strong>{user.name}</strong><small title={user.email}>{user.email}</small></div>
      </div>
      <form method="post" action="/auth/logout">
        <button type="submit" class="btn btn-outline-secondary btn-sm">로그아웃</button>
      </form>
    </div>
  )}
  <details class="member-nav__group" open={!inManage} data-active={!inManage ? 'true' : 'false'}>
    <summary><span>교인 공간</span>{!inManage && <strong>{currentMember}</strong>}<Icon name="chevron-down" size={16} /></summary>
    <ul class="section-nav__list">
      {memberLinks.map((l) => <li><a href={l.href} aria-current={cur(l.href)}>{l.label}</a></li>)}
    </ul>
  </details>
  {isAdmin(user) && (
    <>
      <details class="member-nav__group" open={inManage} data-active={inManage ? 'true' : 'false'}>
        <summary><span>관리자</span>{inManage && <strong>{currentManage}</strong>}<Icon name="chevron-down" size={16} /></summary>
        <ul class="section-nav__list">
          {manageLinks.map((l) => <li><a href={l.href} aria-current={cur(l.href)}>{l.label}</a></li>)}
        </ul>
      </details>
      <details class="member-nav__group member-nav__advanced">
        <summary>고급 도구 <Icon name="chevron-down" size={16} /></summary>
        <ul class="section-nav__list"><li><a href={cmsLink.href} class="member-nav__external" target="_blank" rel="noopener">{cmsLink.label}<span class="sr-only"> (새 창)</span> <Icon name="external" size={14} /></a></li></ul>
      </details>
    </>
  )}
</nav>
<script>
  import { initMemberForms } from '../../scripts/member-forms';
  initMemberForms();
  // 화면 크기가 바뀌어도 현재 위치는 항상 보이고, 모바일에서는 메뉴가 본문을 밀어내지 않습니다.
  const compact = window.matchMedia('(max-width: 991.98px)');
  const update = () => document.querySelectorAll<HTMLDetailsElement>('.member-nav__group[data-active]').forEach((group) => {
    group.open = !compact.matches;
  });
  update();
  compact.addEventListener('change', update);
</script>
