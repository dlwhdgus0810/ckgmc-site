---
interface Props { errors: Record<string, string> }
const { errors } = Astro.props;
---
<div class="alert alert-danger" role="alert" tabindex="-1" data-report-errors hidden={Object.keys(errors).length === 0}>
  <strong>입력 내용을 확인해 주세요.</strong>
  <ul class="mb-0 pl-3 mt-2">{Object.entries(errors).map(([id, message]) => <li><a href={`#${id}`}>{message}</a></li>)}</ul>
</div>
