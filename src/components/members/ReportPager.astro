---
import type { Paging } from '../../lib/http';
interface Props { paging: Paging; param: string; anchor: string; label: string }
const { paging, param, anchor, label } = Astro.props;
const href = (page: number) => {
  const url = new URL(Astro.url);
  url.searchParams.set(param, String(page));
  return url.pathname + url.search + '#' + anchor;
};
const pages = Array.from(new Set([1, paging.page - 1, paging.page, paging.page + 1, paging.pages])).filter(p => p >= 1 && p <= paging.pages).sort((a,b) => a-b);
---
{paging.pages > 1 && <nav aria-label={`${label} 페이지`} class="mt-3">
  <ul class="pagination pagination-sm flex-wrap">
    <li class:list={['page-item', { disabled: paging.page === 1 }]}>{paging.page > 1 ? <a class="page-link" href={href(paging.page - 1)}>이전</a> : <span class="page-link">이전</span>}</li>
    {pages.map((page, index) => <>
      {index > 0 && page > pages[index - 1] + 1 && <li class="page-item disabled"><span class="page-link">…</span></li>}
      <li class:list={['page-item', { active: page === paging.page }]}><a class="page-link" href={href(page)} aria-current={page === paging.page ? 'page' : undefined}>{page}</a></li>
    </>)}
    <li class:list={['page-item', { disabled: paging.page === paging.pages }]}>{paging.page < paging.pages ? <a class="page-link" href={href(paging.page + 1)}>다음</a> : <span class="page-link">다음</span>}</li>
  </ul>
</nav>}
