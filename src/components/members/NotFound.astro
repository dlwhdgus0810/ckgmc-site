---
/** 로그인 구역 안에서 없는 항목을 요청했을 때 (페이지에서 Astro.response.status = 404 를 함께 설정) */
interface Props { back?: string; backLabel?: string }
const { back = '/members', backLabel = '마이페이지로' } = Astro.props;
---
<div class="alert alert-warning" role="alert">요청하신 항목을 찾을 수 없거나 볼 수 있는 권한이 없습니다.</div>
<p><a class="btn btn-outline-primary" href={back}>{backLabel}</a></p>
