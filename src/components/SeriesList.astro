---
/** 설교 시리즈 목록: 진행 중(카드) + 종료(목록) */
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { formatKoreanDate } from '../lib/posts';

interface Props { base: string }
const { base } = Astro.props;
const all = (await getCollection('series')).sort(
  (a, b) => (b.data.updated ?? b.data.date).getTime() - (a.data.updated ?? a.data.date).getTime()
);
const current = all.filter((s) => s.data.ongoing);
const finished = all.filter((s) => !s.data.ongoing);
---
<h2 class="h4 mb-3">진행 중인 시리즈 <small class="text-muted">Current Series</small></h2>
{current.length === 0 ? (
  <p class="text-muted">진행 중인 시리즈가 없습니다.</p>
) : (
  <div class="row">
    {current.map((s) => (
      <div class="col-md-6 mb-4">
        <a class="card-tile" href={`${base}/${s.id}`}>
          <div class="card-tile__media"><img src={s.data.thumbnail} alt="" loading="lazy" width="960" height="540" /></div>
          <div class="card-tile__body">
            <span class="card-tile__eyebrow">진행 중</span>
            <h3 class="card-tile__title h5">{s.data.title}</h3>
            <p class="card-tile__meta">{s.data.episodes.length}편 · {formatKoreanDate(s.data.updated ?? s.data.date)} 업데이트</p>
          </div>
        </a>
      </div>
    ))}
  </div>
)}

{finished.length > 0 && (
  <>
    <h2 class="h4 mt-5 mb-3">지난 시리즈 <small class="text-muted">Finished Series</small></h2>
    <ul class="series-list">
      {finished.map((s) => (
        <li>
          <a class="card-tile card-tile--flat series-list__item" href={`${base}/${s.id}`}>
            <img class="series-list__thumb" src={s.data.thumbnail} alt="" loading="lazy" width="120" height="68" />
            <div>
              <h3 class="h6 mb-1">{s.data.title}</h3>
              <p class="card-tile__meta">{s.data.episodes.length}편 · {formatKoreanDate(s.data.updated ?? s.data.date)}</p>
            </div>
            <Icon name="chevron-right" size={18} />
          </a>
        </li>
      ))}
    </ul>
  </>
)}
