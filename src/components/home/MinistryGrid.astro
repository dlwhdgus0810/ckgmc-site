---
/** 사역 소개 카드 (ministries 섹션 페이지의 image/description 사용) */
import type { CollectionEntry } from 'astro:content';
import SectionHeader from '../SectionHeader.astro';
interface Props { pages: CollectionEntry<'pages'>[] }
const { pages } = Astro.props;
---
{pages.length > 0 && (
  <section class="section" aria-labelledby="ministry-title">
    <div class="container">
      <SectionHeader id="ministry-title" eyebrow="Ministries" title="사역 소개" more={{ href: pages[0] ? '/' + pages[0].id : '/ministries/children', label: '모든 사역' }} />
      <div class="row ministry-grid">
        {pages.map((p) => {
          const img = p.data.image ?? p.data.headerImage;
          return (
            <div class="col-6 col-lg-4 mb-3 mb-md-4">
              <a class="card-tile card-tile--portrait" href={'/' + p.id}>
                {img && <div class="card-tile__media"><img src={img} alt="" loading="lazy" width="1200" height="900" /></div>}
                <div class="card-tile__body">
                  {p.data.subtitle && <span class="card-tile__eyebrow">{p.data.subtitle}</span>}
                  <h3 class="card-tile__title h5">{p.data.title}</h3>
                  {p.data.description && <p class="card-tile__text">{p.data.description}</p>}
                </div>
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
