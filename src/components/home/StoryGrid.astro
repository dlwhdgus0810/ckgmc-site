---
/** 우리 교회 이야기 카드 그리드 (메인: 8개, /story: 전체) */
import type { CollectionEntry } from 'astro:content';
import { formatKoreanDate, isoDate, storyExcerpt } from '../../lib/posts';
interface Props {
  stories: CollectionEntry<'stories'>[];
  limit?: number;
  /** 카드 제목 단계 — 바로 위 제목이 h1 인 /story 에서는 'h2' (단계를 건너뛰지 않게) */
  heading?: 'h2' | 'h3';
}
const { stories, limit, heading: Heading = 'h3' } = Astro.props;
const list = limit ? stories.slice(0, limit) : stories;
---
<div class:list={['story-grid', { 'story-grid--home': !!limit }]}>
  {list.map((s) => (
    <a class="card-tile card-tile--portrait" href={`/story/${s.id}`}>
      <div class="card-tile__media">
        {s.data.image ? <img src={s.data.image} alt="" loading="lazy" width="1000" height="750" /> : <div class="story-grid__placeholder" aria-hidden="true"></div>}
      </div>
      <div class="card-tile__body">
        <p class="card-tile__meta"><time datetime={isoDate(s.data.date)}>{formatKoreanDate(s.data.date)}</time></p>
        <Heading class="card-tile__title h6">{s.data.title}</Heading>
        <p class="card-tile__text">{storyExcerpt(s, 90)}</p>
      </div>
    </a>
  ))}
</div>
