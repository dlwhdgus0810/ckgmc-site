---
import { liveUrl } from '../../data/site';
import { pdfOf, fileUrl, type Post } from '../../lib/posts';
import Icon from '../Icon.astro';
interface Props { bulletin?: Post }
const pdf = Astro.props.bulletin ? pdfOf(Astro.props.bulletin) : undefined;
const links = [
  { title: '이번 주 주보', description: pdf ? 'PDF 바로 열기' : '최근 주보 보기', href: pdf ? fileUrl(pdf.file) : '/media/bulletins', icon: 'file-text', external: !!pdf },
  { title: '예배 영상', description: 'YouTube 예배 채널', href: liveUrl, icon: 'play', external: true },
  { title: '길찾기·주차', description: '주소와 방문 안내', href: '/about/directions', icon: 'map-pin', external: false },
  { title: '처음 방문', description: '예배·자녀·새가족 안내', href: '/welcome', icon: 'user', external: false },
];
---
<nav class="home-shortcuts container" aria-label="자주 찾는 안내">
  {links.map((l) => (
    <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>
      <Icon name={l.icon} size={24} />
      <span><strong>{l.title}</strong><small>{l.description}</small></span>
      {l.external && <span class="sr-only"> (새 창)</span>}
    </a>
  ))}
</nav>
