---
/** 교회 환영 이미지와 소식 포스터를 같은 상단 배너에서 보여줍니다. */
import { site } from '../../data/site';
import Icon from '../Icon.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
interface Props { today: string }
const { today } = Astro.props;
const h = site.hero;
const notices = site.notices.filter((notice) => !notice.until || notice.until >= today);
const titles = [h.headline, ...notices.map((notice) => notice.title ?? '교회 안내')];
---
<section class="hero" data-banner-carousel aria-roledescription="슬라이드 배너" aria-label="교회 안내와 소식">
  <div class="hero__viewport" data-banner-viewport>
    <div class="hero__track" id="hero-banner-track" data-banner-track aria-live="off">
      <div class="hero__slide hero__slide--welcome" data-banner-slide data-banner-title={h.headline} role="group" aria-roledescription="슬라이드" aria-label={`1 / ${titles.length}: ${h.headline}`}>
        <ResponsiveImage class="hero__img" src={h.image} alt={h.alt} sizes="(min-width: 768px) 1600px, 100vw" fetchpriority="high" loading="eager" decoding="async" />
        <div class="hero__scrim" aria-hidden="true"></div>
        <div class="container hero__content">
          {h.eyebrow && <p class="hero__eyebrow">{h.eyebrow}</p>}
          <h1 id="hero-title" class="hero__title">{h.headline}</h1>
          {h.subline && <p class="hero__sub">{h.subline}</p>}
          <div class="hero__actions">
            <a class="btn btn-primary btn-lg" href={h.primary.href}>{h.primary.label}</a>
            <a class="btn btn-outline-primary btn-lg" href={h.secondary.href}>{h.secondary.label}</a>
            <a class="hero__english" href="/visit-en" lang="en">English visitor guide</a>
          </div>
        </div>
      </div>
      {notices.map((notice, index) => (
        <div class="hero__slide hero__slide--notice" data-banner-slide data-banner-title={notice.title ?? '교회 안내'} role="group" aria-roledescription="슬라이드" aria-label={`${index + 2} / ${titles.length}: ${notice.title ?? '교회 안내'}`}>
          <a class="hero__poster-link" href={notice.href || '/about/contact'} aria-label={`${notice.title ?? '교회 안내'} — ${notice.actionLabel || '자세히 보기'}`}>
            <ResponsiveImage class="hero__poster" src={notice.image} alt={notice.alt} loading="lazy" sizes="(min-width: 768px) 1600px, 100vw" />
          </a>
          <div class="hero__caption">
            <h2>{notice.title ?? '교회 안내'}</h2>
            {notice.description && <p>{notice.description}</p>}
            <a class="btn btn-primary" href={notice.href || '/about/contact'}>{notice.actionLabel || '자세히 보기'} <Icon name="arrow-right" size={16} /></a>
          </div>
        </div>
      ))}
    </div>
  </div>
  {notices.length > 0 && (
    <div class="container hero__controls" data-banner-controls hidden>
      <button type="button" class="btn btn-outline-primary btn-sm hero__toggle" data-banner-toggle>자동 재생</button>
      <div class="hero__dots" aria-label="배너 선택">
        {titles.map((title, index) => <button type="button" class="hero__dot" data-banner-dot data-banner-index={index} aria-label={`${index + 1}번째 배너: ${title}`} aria-controls="hero-banner-track"><span aria-hidden="true"></span></button>)}
      </div>
      <div class="hero__navigation">
        <span class="hero__count" data-banner-count>1 / {titles.length}</span>
        <button type="button" class="hero__arrow" data-banner-prev aria-label="이전 배너" aria-controls="hero-banner-track"><Icon name="chevron-right" size={20} class="flip-x" /></button>
        <button type="button" class="hero__arrow" data-banner-next aria-label="다음 배너" aria-controls="hero-banner-track"><Icon name="chevron-right" size={20} /></button>
      </div>
    </div>
  )}
  <p class="sr-only" data-banner-status aria-live="polite" aria-atomic="true"></p>
</section>
<script>import '../../scripts/hero-carousel';</script>
