---
/** 새가족 안내 띠 + 협력 단체 로고 */
import { site } from '../../data/site';
---
<section class="section section--navy newcomer" aria-labelledby="newcomer-title">
  <div class="container text-center">
    <span class="section__eyebrow">Welcome</span>
    <h2 id="newcomer-title" class="newcomer__title">처음 오셨나요? 환영합니다.</h2>
    <p class="newcomer__text">예배 시간과 오시는 길, 자녀 프로그램, 새가족 등록까지 처음 오시는 분들을 위해 안내해 드립니다.</p>
    <div class="newcomer__actions">
      <a class="btn btn-light btn-lg" href="/welcome">처음 오시는 분들께</a>
      <a class="btn btn-outline-light btn-lg" href={site.newFamilyFormUrl} target="_blank" rel="noopener">새가족 등록<span class="sr-only"> (새 창)</span></a>
    </div>
  </div>
</section>
{site.links.length > 0 && (
  <section class="partners" aria-label="협력 단체 링크">
    <div class="container">
      <ul class="partners__list">
        {site.links.map((l) => (
          <li><a href={l.href} target="_blank" rel="noopener" title={l.title}><img src={l.image} alt={l.title} loading="lazy" height="48" /></a></li>
        ))}
      </ul>
    </div>
  </section>
)}
