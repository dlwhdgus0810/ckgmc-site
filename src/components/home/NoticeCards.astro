---
import SectionHeader from '../SectionHeader.astro';
import Icon from '../Icon.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import type { SiteConfig } from '../../data/site';
interface Props { notices: SiteConfig['notices']; today: string }
const { notices: all, today } = Astro.props;
const notices = all.filter((n) => !n.until || n.until >= today);
---
{notices.length > 0 && (
  <section class="section section--surface" aria-labelledby="notices-title">
    <div class="container">
      <SectionHeader id="notices-title" eyebrow="Announcements" title="교회 소식" icon="megaphone" />
      <div class="notice-banner" data-notice-carousel role="region" aria-roledescription="슬라이드 배너" aria-label="교회 소식 배너">
        {notices.length > 1 && (
          <div class="notice-banner__controls" data-notice-controls hidden>
            <button type="button" class="btn btn-outline-primary btn-sm notice-banner__toggle" data-notice-toggle>자동 재생</button>
            <div class="notice-banner__dots" aria-label="소식 선택">
              {notices.map((n, index) => <button type="button" class="notice-banner__dot" data-notice-dot data-notice-index={index} aria-label={`${index + 1}번째 소식: ${n.title ?? '교회 안내'}`} aria-controls="notice-banner-track"><span aria-hidden="true"></span></button>)}
            </div>
            <div class="notice-banner__navigation">
              <span class="notice-banner__count" data-notice-count>1 / {notices.length}</span>
              <button type="button" class="notice-banner__arrow" data-notice-prev aria-label="이전 소식" aria-controls="notice-banner-track"><Icon name="chevron-right" size={20} class="flip-x" /></button>
              <button type="button" class="notice-banner__arrow" data-notice-next aria-label="다음 소식" aria-controls="notice-banner-track"><Icon name="chevron-right" size={20} /></button>
            </div>
          </div>
        )}
        <p class="sr-only" data-notice-status aria-live="polite" aria-atomic="true"></p>
        <div class="notice-banner__viewport" data-notice-viewport>
          <div class="notice-banner__track" id="notice-banner-track" data-notice-track aria-live="off">
            {notices.map((n, index) => (
              <article class="notice-banner__slide" data-notice-slide data-notice-title={n.title ?? '교회 안내'} role="group" aria-roledescription="슬라이드" aria-label={`${index + 1} / ${notices.length}: ${n.title ?? '교회 안내'}`}>
                <a href={n.image} target="_blank" rel="noopener" class="notice-banner__image" aria-label={`${n.title ?? '공지'} 포스터 크게 보기 (새 창)`}>
                  <ResponsiveImage src={n.image} alt={n.alt} loading="lazy" sizes="(min-width: 1200px) 680px, (min-width: 768px) 60vw, 100vw" />
                </a>
                <div class="notice-banner__body">
                  <h3>{n.title ?? '교회 안내'}</h3>
                  {n.description && <p>{n.description}</p>}
                  {(n.time || n.place) && <dl>{n.time && <><dt>일정</dt><dd>{n.time}</dd></>}{n.place && <><dt>장소</dt><dd>{n.place}</dd></>}</dl>}
                  <p class="notice-banner__status">
                    {n.until ? <>안내 기간: {n.until}까지</> : n.reviewedAt ? <>최근 확인: {n.reviewedAt}</> : '참여 전 최신 일정과 운영 여부를 확인해 주세요.'}
                  </p>
                  <a href={n.href || '/about/contact'} class="btn btn-primary">{n.actionLabel || (n.href ? '자세히 보기' : '일정 문의')} <Icon name="arrow-right" size={16} /></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
)}
<script>import '../../scripts/notice-carousel';</script>
